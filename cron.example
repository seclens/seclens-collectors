# --- Chinese Gov/Research (every 6 hours) ---
30 */6 * * *  cd $COLLECTORS_DIR && python collectors/cnnvd_vulnerability/collector.py      >> /var/log/seclens/cnnvd_vulnerability.log 2>&1
35 */6 * * *  cd $COLLECTORS_DIR && python collectors/cnnvd_announcement/collector.py       >> /var/log/seclens/cnnvd_announcement.log 2>&1
40 */6 * * *  cd $COLLECTORS_DIR && python collectors/cnvd_vulnerability/collector.py       >> /var/log/seclens/cnvd_vulnerability.log 2>&1

[Unit]
Description=SecLens Collectors Runner (profile-driven)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/seclens-collectors
EnvironmentFile=/opt/seclens-collectors/.env
ExecStart=/opt/seclens-collectors/.venv/bin/python /opt/seclens-collectors/run_collectors.py --profile profiles/default.json
